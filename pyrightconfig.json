{
  "include": [
    "."
  ],
  "exclude": [
    "**/extmod/asyncio",
    "**/extmod/wasmmod/third_party",
    "**/extmod/wasmmod/docs",
    "**/extmod/wasmmod/tools/**/__pycache__",
    "**/ports/**/build-*/**",
    "**/lib/**",
    "**/third_party/**",
    "**/.venv/**",
    "**/node_modules/**"
  ],
  "extraPaths": [
    "../metal-cdn"
  ],
  "venvPath": "../metal-cdn",
  "venv": ".venv",
  "reportMissingImports": "error",
  "typeCheckingMode": "basic"
}
